/home/azureuser/app/logs/*.log {
    daily
    missingok
    rotate 7
    compress
    delaycompress
    notifempty
    su azureuser azureuser
    create 0664 azureuser azureuser
    sharedscripts
    postrotate
        touch /home/azureuser/app/logs/access.log
        /usr/bin/systemctl reload fail2ban > /dev/null 2>&1 || true
    endscript
}
